# Copy to .env.local for local dev. In Vercel, set the same names under Project → Settings → Environment Variables.
# Never commit real values. Phase in brackets = when the variable starts being used.

# ---------- App ----------
# Public base URL of this app (used for OAuth redirects, QStash callbacks, iCal links). [1]
APP_URL=http://localhost:3000
# debug | info | warn | error [1]
LOG_LEVEL=info

# ---------- Database: Neon Postgres [1] ----------
# Pooled connection string (host contains "-pooler"). Use the `dev` branch locally and for Vercel Preview,
# the `main`/production branch for Vercel Production.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require
# Direct (unpooled) connection string for migrations (same host without "-pooler").
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# ---------- Seed [1] ----------
# First owner account created by `pnpm db:seed`.
OWNER_EMAIL=you@example.com
OWNER_NAME=Your Name

# ---------- Encryption [1] ----------
# 32 random bytes, base64. Encrypts Instagram tokens and webhook secrets (AES-256-GCM).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=

# ---------- Auth: Better Auth [2] ----------
# Random 32+ char secret: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Email for magic links and invites (Resend). Leave RESEND_API_KEY empty in dev: links are printed to the server log.
RESEND_API_KEY=
EMAIL_FROM="Social Planner <planner@yourdomain.com>"

# ---------- Media storage: Vercel Blob [3] ----------
BLOB_READ_WRITE_TOKEN=

# ---------- Scheduling: Upstash QStash [5] ----------
# Exact-time publish triggers + recurring jobs (5-min sweep, IG sync, token refresh, insights, webhooks).
QSTASH_URL=https://qstash.upstash.io
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
# Lets you call /api/jobs/* by hand: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=

# ---------- Instagram API with Instagram Login [5] ----------
# mock = fake Instagram (dev/tests; brands without a connected account still "publish"). real = Graph API.
INSTAGRAM_CLIENT=mock
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=http://localhost:3000/api/instagram/callback

# ---------- Rate limiting: Upstash Redis [7] ----------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
